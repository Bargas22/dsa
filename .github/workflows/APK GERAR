
name: Gerar APK VISAGIO

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar projeto
        uses: actions/checkout@v4

      - name: Instalar Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Instalar Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Verificar projeto Flutter
        run: |
          if [ ! -f frontend/pubspec.yaml ]; then
            echo "ERRO: frontend/pubspec.yaml não encontrado."
            echo "É necessário enviar o projeto Flutter para o repositório."
            exit 1
          fi

      - name: Instalar dependencias
        working-directory: frontend
        run: flutter pub get

      - name: Gerar APK
        working-directory: frontend
        run: flutter build apk --release

      - name: Disponibilizar APK
        uses: actions/upload-artifact@v4
        with:
          name: VISAGIO-APK
          path: frontend/build/app/outputs/flutter-apk/app-release.apk
